# Compose settings (copy to .env; never commit it).
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
HTTP_PORT=8088

# Public host names and origins of the site. For a real deployment use your domain and https.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8088
SECURE_SSL_REDIRECT=false   # true in production (TLS terminated in front of nginx)

GOOGLE_CLIENT_ID=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SENTRY_DSN=
