                    {
                      "label": "D",
                      "text": "630"
                    },
                    {
                      "label": "E",
                      "text": "None of these"
                    }
                  ],
                  "answer": "B",
                  "explanation": "Rates per hour: A $=60/5=12$, B $=2\\times(60/12)=10$, C $=60/10=6$. Combined $=28$ items/hr, so $294/28=10.5$ hours.",
                  "images": [],
                  "needs_review": false
